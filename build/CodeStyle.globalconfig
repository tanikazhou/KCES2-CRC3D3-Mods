dotnet_naming_rule.constant_fields_pascal.style = pascal_case
dotnet_naming_rule.constant_fields_pascal.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.visible_fields.applicable_kinds = field
dotnet_naming_symbols.visible_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_rule.visible_fields_pascal.symbols = visible_fields
dotnet_naming_rule.visible_fields_pascal.style = pascal_case
dotnet_naming_rule.visible_fields_pascal.severity = warning

dotnet_naming_symbols.locals.applicable_kinds = parameter, local
dotnet_naming_rule.locals_camel.symbols = locals
dotnet_naming_rule.locals_camel.style = camel_case
dotnet_naming_rule.locals_camel.severity = warning

