dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I
dotnet_naming_style.t_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_pascal_case.required_prefix = T

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_i_pascal.symbols = interfaces
dotnet_naming_rule.interfaces_i_pascal.style = i_pascal_case
dotnet_naming_rule.interfaces_i_pascal.severity = warning

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_rule.type_parameters_t_pascal.symbols = type_parameters
dotnet_naming_rule.type_parameters_t_pascal.style = t_pascal_case
dotnet_naming_rule.type_parameters_t_pascal.severity = warning

dotnet_naming_symbols.types.applicable_kinds = namespace, class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = warning

dotnet_naming_symbols.members.applicable_kinds = method, property, event, local_function
dotnet_naming_symbols.members.applicable_accessibilities = *
dotnet_naming_rule.members_pascal.symbols = members
dotnet_naming_rule.members_pascal.style = pascal_case
dotnet_naming_rule.members_pascal.severity = warning

