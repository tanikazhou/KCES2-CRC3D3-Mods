root = true

[*.{cs,csproj,projitems,props,targets,slnx,globalconfig,json,md,config,example,user}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
max_line_length = 160
resharper_convert_to_primary_constructor_highlighting = none
resharper_csharp_align_multiline_binary_expressions_chain = false
resharper_csharp_braces_for_dowhile = required_for_multiline_statement
resharper_csharp_braces_for_fixed = required_for_multiline_statement
resharper_csharp_braces_for_for = required_for_multiline_statement
resharper_csharp_braces_for_foreach = required_for_multiline_statement
resharper_csharp_braces_for_ifelse = required_for_multiline
resharper_csharp_braces_for_lock = required_for_multiline_statement
resharper_csharp_braces_for_using = required_for_multiline_statement
resharper_csharp_braces_for_while = required_for_multiline_statement
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_keep_blank_lines_in_declarations = 1
resharper_csharp_place_field_attribute_on_same_line = never
resharper_csharp_trailing_comma_in_multiline_lists = true
resharper_csharp_use_roslyn_logic_for_evident_types = true
resharper_csharp_wrap_before_binary_opsign = true
resharper_inconsistent_naming_highlighting = none
resharper_xmldoc_indent_child_elements = ZeroIndent
resharper_xmldoc_indent_text = ZeroIndent
resharper_xmldoc_space_before_self_closing = false

[*.{csproj,projitems,props,targets,slnx,json,config,example,user}]
indent_size = 2
resharper_xml_blank_line_after_pi = false
resharper_xml_keep_user_linebreaks = true
resharper_xml_linebreaks_inside_tags_for_elements_with_child_elements = false
resharper_xml_wrap_lines = false

[*.md]
trim_trailing_whitespace = false

[*.ks]
charset = utf-8-bom
end_of_line = crlf
